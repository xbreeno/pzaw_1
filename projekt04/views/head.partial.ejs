<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <nav class="navbar">
      <a href="/">Strona główna</a>
      <a href="/participants">Lista uczestników</a>
      <% if (typeof currentUser !== "undefined" && currentUser) { %>
        <% if (typeof currentPath === "undefined" || currentPath !== "/register") { %>
          <a href="/register">Nowy uczestnik</a>
        <% } %>
        <span class="navbar-user">Zalogowany jako <strong><%= currentUser.username %></strong></span>
        <a href="/auth/logout">Wyloguj</a>
      <% } else { %>
        <a href="/auth/login">Zaloguj</a>
        <a href="/auth/signup">Rejestracja konta</a>
      <% } %>
    </nav>
<%- include("head.partial.ejs") %>

<main class="form-page">
  <h1><%= title %></h1>

  <form action="<%= form.action %>" method="POST" novalidate>
    <input type="hidden" name="csrf_token" value="<%= csrfToken || "" %>">
    <div class="field-group">
      <label for="name">Imię</label>
      <input id="name" type="text" name="name" value="<%= form.data.name %>" required>
      <% if (form.errors.name) { %>
        <span class="error-message"><%= form.errors.name %></span>
      <% } %>
    </div>

    <div class="field-group">
      <label for="lname">Nazwisko</label>
      <input id="lname" type="text" name="lname" value="<%= form.data.lname %>" required>
      <% if (form.errors.lname) { %>
        <span class="error-message"><%= form.errors.lname %></span>
      <% } %>
    </div>

    <fieldset class="field-group radio-group">
      <legend>Typ pojazdu</legend>
      <label class="radio-option">
        <span>Cross</span>
        <input type="radio" name="vtype" value="Cross" <%= form.data.vtype === 'Cross' ? 'checked' : '' %> required>
      </label>
      <label class="radio-option">
        <span>Quad</span>
        <input type="radio" name="vtype" value="Quad" <%= form.data.vtype === 'Quad' ? 'checked' : '' %> required>
      </label>
      <% if (form.errors.vtype) { %>
        <span class="error-message"><%= form.errors.vtype %></span>
      <% } %>
    </fieldset>

    <div class="field-group">
      <label for="vbrand">Marka pojazdu</label>
      <input id="vbrand" type="text" name="vbrand" value="<%= form.data.vbrand %>" required>
      <% if (form.errors.vbrand) { %>
        <span class="error-message"><%= form.errors.vbrand %></span>
      <% } %>
    </div>

    <div class="field-group">
      <label for="vmodel">Model pojazdu</label>
      <input id="vmodel" type="text" name="vmodel" value="<%= form.data.vmodel %>" required>
      <% if (form.errors.vmodel) { %>
        <span class="error-message"><%= form.errors.vmodel %></span>
      <% } %>
    </div>

    <div class="button-row">
      <button type="submit" class="submit-button"><%= editing ? 'Zapisz zmiany' : 'Zarejestruj' %></button>
    </div>
  </form>
</main>

<%- include("foot.partial.ejs") %>
